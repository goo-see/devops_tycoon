{
  "name": "devops-tycoon-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser:asset-runtime": "playwright test -c playwright.asset-runtime.config.ts",
    "test:browser:visual-c": "playwright test -c playwright.visual-pr-c.config.ts",
    "generate:api": "openapi-typescript ../contracts/openapi/backend-v1.json -o src/api/generated/backend.d.ts",
    "check:api-drift": "openapi-typescript ../contracts/openapi/backend-v1.json -o /tmp/backend.gen.d.ts && diff -q src/api/generated/backend.d.ts /tmp/backend.gen.d.ts",
    "test:browser:production-image": "playwright test -c playwright.production-image.config.ts",
    "test:browser:effect-preview": "playwright test -c playwright.effect-preview.config.ts",
    "test:browser:event-derived": "playwright test -c playwright.event-derived.config.ts"
  },
  "dependencies": {
    "pixi.js": "^8.6.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@playwright/test": "1.49.1",
    "@types/node": "^20",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.4.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
